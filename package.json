{
  "name": "solid-kas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "bootstrap": "cargo build -p kas-runtime",
    "predev": "pnpm --filter @kas/solid build && pnpm --filter @kas/vite build",
    "dev": "vite examples/counter",
    "prebuild": "pnpm --filter @kas/solid build && pnpm --filter @kas/vite build",
    "build": "pnpm --filter @kas/counter build",
    "test": "pnpm --filter @kas/solid test && pnpm --filter @kas/vite test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "typescript": "5.8.3",
    "vite": "8.3.2",
    "vitest": "3.2.4"
  }
}
